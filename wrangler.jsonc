{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cherryphone",
  "main": "src/worker.ts",
  "compatibility_date": "2025-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cherryphone",
      "database_id": "cherryphone"
    }
  ],
  "routes": [
    {
      "pattern": "phone.kerryhatcher.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENCRYPTION_KEY": ""
  }
}
