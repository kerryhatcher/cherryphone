{
  "name": "cherryphone",
  "version": "0.1.0",
  "description": "A phone dialer app powered by Cloudflare Workers + Twilio",
  "type": "module",
  "scripts": {
    "vendor:sdk": "node scripts/vendor-sdk.mjs",
    "postinstall": "npm run vendor:sdk",
    "predev": "npm run vendor:sdk",
    "predeploy": "npm run vendor:sdk",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@twilio/voice-sdk": "2.18.3",
    "jose": "^5.9.0"
  }
}
